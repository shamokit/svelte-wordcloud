{
	"name": "@shamokit/svelte-wordcloud",
	"private": false,
	"version": "0.4.2",
	"description": "Word cloud component library for Svelte with accessibility support.",
	"author": "shamokit <contact@shamokit.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shamokit/svelte-wordcloud.git"
	},
	"homepage": "https://svelte-wordcloud-docs.vercel.app",
	"bugs": {
		"url": "https://github.com/shamokit/svelte-wordcloud/issues"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"release": "pnpm publish --provenance --no-git-checks",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@threlte/core": "^8.0.0",
		"@threlte/extras": "^9.0.0",
		"svelte": "^5.0.0",
		"three": ">=0.160.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.65.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@threlte/core": "^8.5.16",
		"@threlte/extras": "^9.21.0",
		"@types/three": "^0.184.1",
		"publint": "^0.3.21",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"three": "^0.184.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"word-cloud",
		"3d",
		"threlte",
		"webgl",
		"visualization",
		"accessibility"
	],
	"dependencies": {
		"@lucide/svelte": "^1.20.0",
		"esm-env": "^1.2.2",
		"troika-three-text": "^0.52.4"
	}
}
